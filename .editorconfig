root = true

[Assets/**/*.cs]
dotnet_naming_rule.types_should_be_pascal_case.severity = warning
dotnet_naming_rule.types_should_be_pascal_case.symbols = types
dotnet_naming_rule.types_should_be_pascal_case.style = pascal_case

dotnet_naming_rule.members_should_be_pascal_case.severity = warning
dotnet_naming_rule.members_should_be_pascal_case.symbols = members
dotnet_naming_rule.members_should_be_pascal_case.style = pascal_case

dotnet_naming_rule.parameters_should_be_underscore_pascal_case.severity = warning
dotnet_naming_rule.parameters_should_be_underscore_pascal_case.symbols = parameters
dotnet_naming_rule.parameters_should_be_underscore_pascal_case.style = underscore_pascal_case

dotnet_naming_symbols.types.applicable_kinds = class, struct, interface, enum, delegate
dotnet_naming_symbols.types.applicable_accessibilities = *

dotnet_naming_symbols.members.applicable_kinds = property, method, field, event
dotnet_naming_symbols.members.applicable_accessibilities = *

dotnet_naming_symbols.parameters.applicable_kinds = parameter
dotnet_naming_symbols.parameters.applicable_accessibilities = *

dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_style.underscore_pascal_case.required_prefix = _
dotnet_naming_style.underscore_pascal_case.capitalization = pascal_case
